# ==============================================================================
# INCEL EMPLOYEE AWARDS — API ENVIRONMENT
# Copy to .env and fill in values.
# With DJANGO_DEBUG=False, missing production secrets will block startup.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE DJANGO
# ------------------------------------------------------------------------------
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-this-to-a-secure-random-50-character-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_ADMIN_URL=admin/
# Display / admin wall-clock zone (emails use timezone.localtime). Default: Africa/Lagos.
DJANGO_TIME_ZONE=Africa/Lagos

# Production HTTPS hardening (used when DJANGO_DEBUG=False)
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000

# ------------------------------------------------------------------------------
# 2. DATABASE
# Local: USE_SQLITE=true OR PostgreSQL with empty DB_HOST (Unix socket / peer).
# Production: PostgreSQL with DB_HOST + DB_PASSWORD required.
# ------------------------------------------------------------------------------
USE_SQLITE=false
DB_NAME=incel_awards
DB_USER=micoliser
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# ------------------------------------------------------------------------------
# 3. FRONTEND / CORS / CSRF
# Ballot + email links: {FRONTEND_BASE_URL}/{year}/vote?token=...
# Production FRONTEND_BASE_URL must be https://… (validated when DEBUG=False)
# ------------------------------------------------------------------------------
FRONTEND_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# 4. ORG DIRECTORY SYNC (external users API)
# Client always calls:
#   GET {ORG_USERS_API_BASE_URL}/api/v1/external/users
#   Authorization: Bearer {ORG_USERS_API_TOKEN}
#   Accept: application/json
# ORG_USERS_API_BASE_URL = origin only (no /api/v1 path).
# Local fake API uses the same path when DEV_ORG_USERS_ENABLED=True.
# ------------------------------------------------------------------------------
ORG_USERS_API_BASE_URL=http://127.0.0.1:8000
ORG_USERS_API_TOKEN=dev-org-token
ORG_USERS_API_AUTH_SCHEME=Bearer
DEV_ORG_USERS_ENABLED=True
# Live-test allowlist (comma-separated). Empty = use everyone from the org API.
# When set, only these emails stay active after sync (ballots, emails, voting).
ORG_USERS_TEST_EMAILS=

# ------------------------------------------------------------------------------
# 5. EMAIL
# Local: console backend. Production: SMTP + EMAIL_ENABLED=True, EMAIL_DEBUG=False.
# Season emails (Celery beat / run_season_tick):
#   - eligibility_notice (categories only) at opens − offset_minutes
#   - vote_invite (personal ballot link) at opens − offset_minutes
# Offsets are configured per Award year in Django admin.
# ------------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp-relay.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=awards@incelgroup.com
EMAIL_SENDER_NAME=Incel Group Awards
EMAIL_ENABLED=True
EMAIL_DEBUG=False

# ------------------------------------------------------------------------------
# 6. CELERY (Redis) — worker + beat required for automatic sync/emails/status
# Optional one-shot: python manage.py run_season_tick  (sync + mail together)
# ------------------------------------------------------------------------------
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=False
# Frequent: tokens + due emails + voting status (no workspace API).
SEASON_TICK_SECONDS=60
# Infrequent: ORG_USERS_API sync (+ mint tokens for new people).
ORG_SYNC_SECONDS=3600

# ------------------------------------------------------------------------------
# 7. BALLOT RATE LIMITS
# Format: "<count>/<period>" — second|minute|hour|day
# ------------------------------------------------------------------------------
BALLOT_THROTTLE_RESOLVE=60/min
BALLOT_THROTTLE_VOTE=30/min
BALLOT_THROTTLE_DIRECTORY=60/min

